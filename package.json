{
  "name": "earthquake-explorer",
  "description": "A small ArcGIS earthquake explorer powered by public USGS data",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "node --test src/earthquakes.test.ts",
    "build": "tsc && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@arcgis/core": "^5.1.0",
    "@arcgis/map-components": "^5.1.0",
    "@esri/calcite-components": "^5.1.1"
  },
  "devDependencies": {
    "@types/node": "~24.10.1",
    "typescript": "~6.0.2",
    "vite": "^8.0.16"
  }
}
